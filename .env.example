# Copy to .env and fill in. Never commit .env.

# Which model provider runs the audit: anthropic or openai.
SENTINEL_PROVIDER=anthropic

# Claude API key, read directly by the Anthropic SDK.
ANTHROPIC_API_KEY=

# OpenAI API key, read directly by the OpenAI SDK. Used when SENTINEL_PROVIDER=openai.
OPENAI_API_KEY=

# Leave empty to use the in-memory store (nothing is kept between runs).
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_REDIS_URL=redis://localhost:6379

# Claude model and reasoning effort (low | medium | high | xhigh | max).
SENTINEL_MODEL=claude-opus-5-5
SENTINEL_EFFORT=medium
SENTINEL_OPENAI_MODEL=gpt-5.5
# Empty uses the model default; or low | medium | high.
SENTINEL_OPENAI_REASONING_EFFORT=

# "fastembed" runs a local embedding model; "hash" needs no download and is for tests.
SENTINEL_EMBEDDER=fastembed

# Path or git URL of the codebase to audit. Defaults to the bundled demo app.
SENTINEL_TARGET_REPO=

# Alerts. Leave a channel's settings empty to switch it off.
SENTINEL_ALERT_MIN_SEVERITY=critical
SENTINEL_SLACK_WEBHOOK_URL=
SENTINEL_SMTP_HOST=
SENTINEL_SMTP_PORT=587
SENTINEL_SMTP_USER=
SENTINEL_SMTP_PASSWORD=
SENTINEL_ALERT_EMAIL_FROM=
SENTINEL_ALERT_EMAIL_TO=

# Bearer token for POST /trigger. The endpoint is disabled while this is empty.
SENTINEL_TRIGGER_TOKEN=
